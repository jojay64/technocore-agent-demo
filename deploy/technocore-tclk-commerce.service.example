[Unit]
Description=Technocore guarded tclk PAPER commerce agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/home/ubuntu/technocore-agent-demo
EnvironmentFile=/home/ubuntu/technocore-agent-demo/.env
Environment=PYTHONUNBUFFERED=1
Environment=TCLK_IDENTITY_FILE=/home/ubuntu/technocore-agent-demo/research_identity.json
Environment=TCLK_COMMERCE_STATE_FILE=/home/ubuntu/technocore-agent-demo/.cache/tclk_commerce_state.json
Environment=TCLK_COMMERCE_DECISION_LOG=/home/ubuntu/technocore-agent-demo/.cache/tclk_commerce_decisions.jsonl
Environment=TCLK_COMMERCE_TRANSCRIPT_LOG=/home/ubuntu/technocore-agent-demo/.cache/tclk_commerce_transcripts.jsonl
Environment=TCLK_COMMERCE_PRIVATE_STATE_FILE=/home/ubuntu/technocore-agent-demo/.cache/tclk_commerce_private_state.json
Environment=TCLK_COMMERCE_MODE=PAPER_COMMERCE
ExecStart=/home/ubuntu/technocore-agent-demo/.venv/bin/python /home/ubuntu/technocore-agent-demo/tclk_commerce_agent.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/technocore-agent-demo/.cache

[Install]
WantedBy=multi-user.target
