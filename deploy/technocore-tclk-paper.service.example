[Unit]
Description=Technocore tclk PAPER offer watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/technocore-agent-demo
EnvironmentFile=/home/ubuntu/technocore-agent-demo/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/technocore-agent-demo/.venv/bin/python /home/ubuntu/technocore-agent-demo/tclk_offer_watcher.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/technocore-agent-demo/.cache
ReadWritePaths=/home/ubuntu/technocore-agent-demo/tclk_offer_evaluations.jsonl

[Install]
WantedBy=multi-user.target
